# ============================================
# Aetheria AI – Konfiguration
# ============================================
# Kopiere diese Datei nach .env und füge deine API-Keys ein:
#   cp .env.example .env
#
# Dann starte die App mit:
#   bash start.sh
# ============================================

# PFLICHT für echte KI (Text + Objekt-Scan)
# Bekommst du auf: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OPTIONAL für Bildgenerierung (DALL-E 3)
# Bekommst du auf: https://platform.openai.com/
OPENAI_API_KEY=

# OPTIONAL: Welches Claude-Modell soll genutzt werden
# AI_TEXT_MODEL=claude-sonnet-4-20250514

# OPTIONAL: Server-Port (Standard: 4000)
# PORT=4000
