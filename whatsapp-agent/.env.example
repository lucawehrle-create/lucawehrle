# Anthropic API Key für Claude
ANTHROPIC_API_KEY=sk-ant-...

# Claude Model (optional, Standard: claude-sonnet-4-20250514)
CLAUDE_MODEL=claude-sonnet-4-20250514

# Systemanweisung für den AI-Agenten
# Definiert Tonalität und Verhalten
SYSTEM_PROMPT=Du bist ein hilfreicher Assistent, der WhatsApp-Nachrichten im Namen des Nutzers beantwortet. Antworte natürlich, freundlich und in der gleichen Sprache wie die eingehende Nachricht. Halte dich kurz und prägnant.

# Erlaubte Chat-IDs (kommagetrennt, leer = alle Chats)
# Einzelne Kontakte: 49123456789@s.whatsapp.net
# Gruppen: 49123456789-1234567890@g.us
ALLOWED_CHATS=

# Blockierte Chat-IDs (kommagetrennt)
BLOCKED_CHATS=

# Auto-Reply aktivieren (true/false)
AUTO_REPLY_ENABLED=true

# Verzögerung vor dem Antworten in Sekunden (simuliert Tipp-Zeit)
REPLY_DELAY_SECONDS=3

# Maximale Nachrichten-Historie pro Chat (für Kontext)
MAX_HISTORY=20

# Nur auf Nachrichten antworten die an mich gerichtet sind (in Gruppen)
GROUPS_ONLY_WHEN_MENTIONED=true

# Log-Level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
