# ============================================
# Aetheria AI – Konfiguration
# ============================================
# Kopiere diese Datei nach .env und fuege deine API-Keys ein:
#   cp .env.example .env
#
# Dann starte die App mit:
#   bash start.sh
# ============================================

# === KI-ANBIETER (einen der beiden setzen) ===

# Option A: Anthropic Claude (Text + Objekt-Scan)
# Key bekommst du auf: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Option B: Google Gemini (Text + Objekt-Scan)
# Key bekommst du auf: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === OPTIONAL ===

# Bildgenerierung mit DALL-E 3 (ohne = Platzhalter-Bilder)
# Key bekommst du auf: https://platform.openai.com/
OPENAI_API_KEY=

# KI-Anbieter manuell erzwingen: "anthropic", "gemini" oder "mock"
# (wird automatisch erkannt wenn nicht gesetzt)
# AI_PROVIDER=

# Modell-Name ueberschreiben (abhaengig vom Anbieter)
# AI_TEXT_MODEL=claude-sonnet-4-20250514
# AI_TEXT_MODEL=gemini-2.0-flash

# Server-Port (Standard: 4000)
# PORT=4000
